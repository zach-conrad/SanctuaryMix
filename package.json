{
  "name": "sanctuary-mix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:web": "npm run lint && npm run typecheck && npm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check": "npm run check:web && npm run check:rust",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.1.16",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6",
    "vitest": "^5.0.3"
  }
}
